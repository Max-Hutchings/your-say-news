{
 "uid": "ysn-mobile-app",
 "title": "Your Say News - Mobile app",
 "description": "What people do in the Expo app: screens, taps, API calls, crashes and per-session click journeys.",
 "tags": [
  "your-say-news",
  "mobile"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "timepicker": {},
 "links": [
  {
   "type": "dashboards",
   "title": "Your Say News",
   "tags": [
    "your-say-news"
   ],
   "asDropdown": true,
   "includeVars": false,
   "keepTime": true,
   "icon": "external link",
   "targetBlank": false
  }
 ],
 "templating": {
  "list": [
   {
    "name": "environment",
    "label": "Environment",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(yoursay_mobile_sessions_total, environment)",
     "refId": "environment"
    },
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all",
     "selected": true
    }
   },
   {
    "name": "platform",
    "label": "Platform",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(yoursay_mobile_sessions_total, platform)",
     "refId": "platform"
    },
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all",
     "selected": true
    }
   },
   {
    "name": "user",
    "label": "User id",
    "type": "textbox",
    "query": ".*",
    "current": {
     "text": ".*",
     "value": ".*",
     "selected": false
    },
    "description": "Internal account id (YourSayUser.id). .* shows every user. Logs and traces only - never a metric label (ADR-060)."
   },
   {
    "name": "session",
    "label": "Session",
    "type": "textbox",
    "query": "",
    "current": {
     "text": "",
     "value": "",
     "selected": false
    },
    "description": "A session.id from the Recent sessions panel. Shows that launch's full click journey."
   }
  ]
 },
 "annotations": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Overview",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Sessions in selected period",
   "description": "App launches. One session id per launch, never linked to an account.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(yoursay_mobile_sessions_total{environment=~\"$environment\", platform=~\"$platform\"}[$__range]))",
     "legendFormat": "__auto",
     "editorMode": "code",
     "range": false,
     "instant": true
    }
   ],
   "links": [],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
