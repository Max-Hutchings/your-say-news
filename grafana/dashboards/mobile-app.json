  {
   "id": 7,
   "type": "stat",
   "title": "API faults + crashes in selected period",
   "description": "5xx responses, dropped connections, timeouts and app crashes. Faults are counted apart from errors.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 20,
