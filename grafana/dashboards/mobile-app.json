   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(sum(increase(yoursay_mobile_operations_total{environment=~\"$environment\", platform=~\"$platform\", outcome=\"fault\"}[$__range])) or vector(0)) + (sum(increase(yoursay_mobile_app_faults_total{environment=~\"$environment\", platform=~\"$platform\"}[$__range])) or vector(0))",
     "legendFormat": "__auto",
     "editorMode": "code",
