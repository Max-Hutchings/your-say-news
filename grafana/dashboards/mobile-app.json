  {
   "id": 10,
   "type": "timeseries",
   "title": "API error and fault percentage",
   "description": "Separate lines: errors are handled, faults are not.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 13
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * sum(rate(yoursay_mobile_operations_total{environment=~\"$environment\", platform=~\"$platform\", outcome=\"error\"}[$__rate_interval])) / clamp_min(sum(rate(yoursay_mobile_operations_total{environment=~\"$environment\", platform=~\"$platform\"}[$__rate_interval])), 1e-9)",
     "legendFormat": "error %",
     "editorMode": "code",
     "range": true,
     "instant": false
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * sum(rate(yoursay_mobile_operations_total{environment=~\"$environment\", platform=~\"$platform\", outcome=\"fault\"}[$__rate_interval])) / clamp_min(sum(rate(yoursay_mobile_operations_total{environment=~\"$environment\", platform=~\"$platform\"}[$__rate_interval])), 1e-9)",
     "legendFormat": "fault %",
     "editorMode": "code",
     "range": true,
     "instant": false
    }
   ],
   "links": [],
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": true,
      "axisSoftMin": 0
     }
    },
    "overrides": []
   }
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "API latency on the device p50 / p95 / p99",
   "description": "Includes the network, so it is always slower than the post-service request latency.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 13
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (rate(yoursay_mobile_operation_duration_milliseconds_bucket{environment=~\"$environment\", platform=~\"$platform\"}[$__rate_interval])))",
     "legendFormat": "p50",
     "editorMode": "code",
     "range": true,
     "instant": false
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(yoursay_mobile_operation_duration_milliseconds_bucket{environment=~\"$environment\", platform=~\"$platform\"}[$__rate_interval])))",
     "legendFormat": "p95",
     "editorMode": "code",
     "range": true,
     "instant": false
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.99, sum by (le) (rate(yoursay_mobile_operation_duration_milliseconds_bucket{environment=~\"$environment\", platform=~\"$platform\"}[$__rate_interval])))",
     "legendFormat": "p99",
     "editorMode": "code",
     "range": true,
     "instant": false
    }
   ],
   "links": [],
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": true,
      "axisSoftMin": 0
     }
    },
    "overrides": []
   }
