<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="0012-add-post-jurisdiction" author="codex">
        <addColumn tableName="post">
            <column name="jurisdiction" type="varchar(32)" defaultValue="GLOBAL">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <sql>
            ALTER TABLE post
                ADD CONSTRAINT ck_post_jurisdiction
                    CHECK (jurisdiction ~ '^[A-Z0-9_-]{2,32}$')
        </sql>
    </changeSet>

    <changeSet id="0012-create-unwrapped-lifecycle" author="codex">
        <createTable tableName="unwrapped_reconciliation">
            <column name="post_id" type="bigint">
                <constraints primaryKey="true" primaryKeyName="pk_unwrapped_reconciliation"
                             nullable="false"/>
            </column>
            <column name="dirty_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="unwrapped_analysis_job">
            <column name="id" type="uuid">
                <constraints primaryKey="true" primaryKeyName="pk_unwrapped_analysis_job" nullable="false"/>
            </column>
            <column name="mode" type="varchar(16)"><constraints nullable="false"/></column>
            <column name="post_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="milestone" type="integer"/>
            <column name="analysis_version" type="varchar(64)"><constraints nullable="false"/></column>
            <column name="prediction_version" type="varchar(64)"/>
            <column name="status" type="varchar(24)"><constraints nullable="false"/></column>
            <column name="attempt_count" type="integer" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="next_attempt_at" type="timestamp with time zone"/>
            <column name="canonical_vote_count" type="bigint"/>
            <column name="aggregate_json" type="jsonb"/>
            <column name="aggregate_version" type="varchar(80)"/>
            <column name="model" type="varchar(128)"/>
            <column name="provider_response_id" type="varchar(160)"/>
            <column name="error_code" type="varchar(80)"/>
            <column name="error_message" type="varchar(512)"/>
            <column name="created_at" type="timestamp with time zone"><constraints nullable="false"/></column>
            <column name="started_at" type="timestamp with time zone"/>
            <column name="completed_at" type="timestamp with time zone"/>
        </createTable>
        <sql>
            ALTER TABLE unwrapped_analysis_job
                ADD CONSTRAINT ck_unwrapped_job_mode CHECK (mode IN ('PREDICTION','OBSERVED')),
                ADD CONSTRAINT ck_unwrapped_job_status
                    CHECK (status IN ('PENDING','GENERATING','DRAFT_READY','FAILED')),
                ADD CONSTRAINT ck_unwrapped_job_shape CHECK (
                    (mode = 'PREDICTION' AND milestone IS NULL AND prediction_version IS NOT NULL)
                    OR (mode = 'OBSERVED' AND milestone IS NOT NULL)
                );
            CREATE UNIQUE INDEX uk_unwrapped_prediction_job
                ON unwrapped_analysis_job(post_id, prediction_version)
                WHERE mode = 'PREDICTION';
            CREATE UNIQUE INDEX uk_unwrapped_observed_job
                ON unwrapped_analysis_job(post_id, milestone, analysis_version)
                WHERE mode = 'OBSERVED';
        </sql>
        <createIndex tableName="unwrapped_analysis_job" indexName="ix_unwrapped_job_status">
            <column name="status"/><column name="next_attempt_at"/>
        </createIndex>

        <createTable tableName="unwrapped_story">
            <column name="id" type="uuid">
                <constraints primaryKey="true" primaryKeyName="pk_unwrapped_story" nullable="false"/>
            </column>
            <column name="job_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="mode" type="varchar(16)"><constraints nullable="false"/></column>
            <column name="post_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="milestone" type="integer"/>
            <column name="canonical_vote_count" type="bigint"><constraints nullable="false"/></column>
            <column name="aggregate_version" type="varchar(80)"/>
            <column name="story_schema_version" type="varchar(64)"><constraints nullable="false"/></column>
            <column name="analysis_version" type="varchar(64)"><constraints nullable="false"/></column>
            <column name="prompt_version" type="varchar(64)"><constraints nullable="false"/></column>
            <column name="rule_set_version" type="varchar(64)"><constraints nullable="false"/></column>
            <column name="model" type="varchar(128)"><constraints nullable="false"/></column>
            <column name="story_json" type="jsonb"><constraints nullable="false"/></column>
            <column name="review_status" type="varchar(16)"><constraints nullable="false"/></column>
            <column name="reviewer_user_id" type="bigint"/>
            <column name="review_note" type="varchar(512)"/>
            <column name="generated_at" type="timestamp with time zone"><constraints nullable="false"/></column>
            <column name="reviewed_at" type="timestamp with time zone"/>
        </createTable>
        <addUniqueConstraint tableName="unwrapped_story" columnNames="job_id"
                             constraintName="uk_unwrapped_story_job"/>
        <sql>
            ALTER TABLE unwrapped_story
                ADD CONSTRAINT ck_unwrapped_story_review
                    CHECK (review_status IN ('DRAFT','APPROVED','REJECTED'));
        </sql>
        <createIndex tableName="unwrapped_story" indexName="ix_unwrapped_story_delivery">
            <column name="post_id"/><column name="review_status"/><column name="milestone" descending="true"/>
        </createIndex>

        <createTable tableName="unwrapped_source">
            <column name="story_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="citation_id" type="varchar(80)"><constraints nullable="false"/></column>
            <column name="url" type="text"><constraints nullable="false"/></column>
            <column name="publisher" type="varchar(256)"/>
            <column name="title" type="varchar(512)"/>
            <column name="classification" type="varchar(24)"><constraints nullable="false"/></column>
            <column name="accessed_at" type="timestamp with time zone"><constraints nullable="false"/></column>
        </createTable>
        <addPrimaryKey tableName="unwrapped_source" columnNames="story_id,citation_id"
                       constraintName="pk_unwrapped_source"/>

        <createTable tableName="unwrapped_follow_up">
            <column name="id" type="uuid">
                <constraints primaryKey="true" primaryKeyName="pk_unwrapped_follow_up" nullable="false"/>
            </column>
            <column name="user_id" type="bigint"><constraints nullable="false"/></column>
            <column name="post_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="story_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="original_option_id" type="bigint"><constraints nullable="false"/></column>
            <column name="follow_up_option_id" type="bigint"><constraints nullable="false"/></column>
            <column name="created_at" type="timestamp with time zone"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="unwrapped_follow_up" columnNames="user_id,post_id"
                             constraintName="uk_unwrapped_follow_up_user_post"/>
        <addForeignKeyConstraint baseTableName="unwrapped_reconciliation" baseColumnNames="post_id"
                                 referencedTableName="post" referencedColumnNames="id"
                                 constraintName="fk_unwrapped_reconciliation_post" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="unwrapped_analysis_job" baseColumnNames="post_id"
                                 referencedTableName="post" referencedColumnNames="id"
                                 constraintName="fk_unwrapped_job_post" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="unwrapped_story" baseColumnNames="job_id"
                                 referencedTableName="unwrapped_analysis_job" referencedColumnNames="id"
                                 constraintName="fk_unwrapped_story_job" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="unwrapped_story" baseColumnNames="post_id"
                                 referencedTableName="post" referencedColumnNames="id"
                                 constraintName="fk_unwrapped_story_post" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="unwrapped_source" baseColumnNames="story_id"
                                 referencedTableName="unwrapped_story" referencedColumnNames="id"
                                 constraintName="fk_unwrapped_source_story" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="unwrapped_follow_up" baseColumnNames="post_id"
                                 referencedTableName="post" referencedColumnNames="id"
                                 constraintName="fk_unwrapped_follow_up_post" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="unwrapped_follow_up" baseColumnNames="story_id"
                                 referencedTableName="unwrapped_story" referencedColumnNames="id"
                                 constraintName="fk_unwrapped_follow_up_story" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="unwrapped_follow_up"
                                 baseColumnNames="post_id,original_option_id"
                                 referencedTableName="post_vote_option"
                                 referencedColumnNames="post_id,id"
                                 constraintName="fk_unwrapped_follow_up_original_option"
                                 onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="unwrapped_follow_up"
                                 baseColumnNames="post_id,follow_up_option_id"
                                 referencedTableName="post_vote_option"
                                 referencedColumnNames="post_id,id"
                                 constraintName="fk_unwrapped_follow_up_new_option"
                                 onDelete="CASCADE"/>
    </changeSet>
</databaseChangeLog>
