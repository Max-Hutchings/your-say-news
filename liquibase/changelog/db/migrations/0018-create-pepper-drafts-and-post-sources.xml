<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="0018-create-pepper-drafts-and-post-sources" author="codex">
        <renameColumn tableName="post" oldColumnName="is_unbiased"
                      newColumnName="is_ai_generated" columnDataType="boolean"/>

        <createTable tableName="pepper_ai_draft_post">
            <column name="id" type="uuid">
                <constraints primaryKey="true" primaryKeyName="pk_pepper_ai_draft_post" nullable="false"/>
            </column>
            <column name="user_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="prompt" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="replica_id" type="varchar(128)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(32)">
                <constraints nullable="false"/>
            </column>
            <!-- Null while running, true on completion, false on a terminal generation fault. -->
            <column name="success" type="boolean"/>
            <!-- Immutable generated result and the separately editable working copy. -->
            <column name="generated_content" type="jsonb"/>
            <column name="content" type="jsonb"/>
            <column name="model" type="varchar(128)"/>
            <column name="provider_response_id" type="varchar(128)"/>
            <column name="error_code" type="varchar(64)"/>
            <column name="error_message" type="varchar(160)"/>
            <column name="published_post_id" type="bigint"/>
            <column name="version" type="integer" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="completed_at" type="timestamp with time zone"/>
        </createTable>
        <sql>
            ALTER TABLE pepper_ai_draft_post
                ADD CONSTRAINT ck_pepper_ai_draft_status
                    CHECK (status IN ('RECEIVED', 'GENERATING', 'FINISHED', 'FAILED')),
                ADD CONSTRAINT ck_pepper_ai_draft_success
                    CHECK ((status IN ('RECEIVED', 'GENERATING') AND success IS NULL)
                        OR (status = 'FINISHED' AND success IS TRUE)
                        OR (status = 'FAILED' AND success IS FALSE)),
                ADD CONSTRAINT ck_pepper_ai_draft_version
                    CHECK (version &gt;= 0)
        </sql>
        <createIndex tableName="pepper_ai_draft_post" indexName="ix_pepper_draft_user_updated">
            <column name="user_id"/>
            <column name="updated_at" descending="true"/>
        </createIndex>

        <addColumn tableName="post">
            <column name="ai_draft_id" type="uuid"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="post" baseColumnNames="ai_draft_id"
                                 referencedTableName="pepper_ai_draft_post" referencedColumnNames="id"
                                 constraintName="fk_post_ai_draft" onDelete="RESTRICT"/>
        <addUniqueConstraint tableName="post" columnNames="ai_draft_id"
                             constraintName="uk_post_ai_draft"/>

        <createTable tableName="post_source">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_post_source" nullable="false"/>
            </column>
            <column name="post_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="url" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="publisher" type="varchar(256)">
                <constraints nullable="false"/>
            </column>
            <column name="ordinal" type="integer">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="post_source" baseColumnNames="post_id"
                                 referencedTableName="post" referencedColumnNames="id"
                                 constraintName="fk_post_source_post" onDelete="CASCADE"/>
        <addUniqueConstraint tableName="post_source" columnNames="post_id, ordinal"
                             constraintName="uk_post_source_ordinal"/>
        <createIndex tableName="post_source" indexName="ix_post_source_post">
            <column name="post_id"/>
        </createIndex>
        <!-- The legacy queue table is intentionally retained for a safe rollout and historical
             data recovery. No production code reads from or writes to it after this migration. -->
    </changeSet>
</databaseChangeLog>
