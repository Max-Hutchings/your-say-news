<?xml version="1.0" encoding="UTF-8"?>
<!-- Seed / test data ONLY. No schema changes here.
     Run by the dedicated seeding container on `docker compose up` (not by the app at start). -->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">
    <includeAll path="user-seeding" relativeToChangelogFile="true"/>
    <include file="seeding/0000-reset-seed-data.xml" relativeToChangelogFile="true"/>
    <include file="seeding/0010-seed-curated-posts.xml" relativeToChangelogFile="true"/>
    <include file="seeding/0011-clear-seeded-unwrapped-queue.xml" relativeToChangelogFile="true"/>
    <include file="seeding/0013-seed-post-topic-tags.xml" relativeToChangelogFile="true"/>
    <include file="seeding/0014-seed-smoke-journey-posts.xml" relativeToChangelogFile="true"/>
</databaseChangeLog>
