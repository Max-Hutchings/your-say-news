<?xml version="1.0" encoding="UTF-8"?>
<!-- Production migrations: schema changes and required reference data. No seed/test fixtures here.
     Run by the application (migrate-at-start) and by the dedicated migration container. -->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">
    <includeAll path="user-migrations" relativeToChangelogFile="true"/>
    <includeAll path="migrations" relativeToChangelogFile="true"/>
</databaseChangeLog>
